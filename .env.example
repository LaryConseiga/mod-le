# Supabase > Project Settings > Database > Connection pooling ("Session" mode — IPv4)
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres

# console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Meta for Developers > ton app > WhatsApp > API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# choisi par toi, à renseigner aussi dans la config du webhook côté Meta
META_VERIFY_TOKEN=
# Meta for Developers > ton app > Paramètres de base > Clé secrète de l'app
META_APP_SECRET=

# Laisser vide tant que le contrat avec l'app partenaire n'est pas confirmé
# (Feuille A-08) — les commandes restent alors "pending" dans orders_outbox.
PARTNER_API_URL=
PARTNER_API_KEY=
